{
  "name": "teapot-phone-agent",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  // 可选：如需绑定自有域名，请取消下方注释并改为你的域名
  // Optional: uncomment and set your custom domain if desired
  // "routes": [
  //   { "pattern": "phone.example.com", "custom_domain": true }
  // ],
  // 可选：如需接入 ChatGPT / Claude 以外的远程 OAuth MCP 客户端，显式追加允许的回调主机名（逗号分隔）
  // Optional: comma-separated extra HTTPS redirect hosts for additional OAuth MCP clients
  // "vars": {
  //   "ALLOWED_REDIRECT_HOSTS": "gemini.google.com"
  // },
  "durable_objects": {
    "bindings": [
      { "name": "PHONE_HUB", "class_name": "PhoneHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhoneHub"] }
  ]
}
