{
  "name": "teapot-phone-agent",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "PHONE_HUB", "class_name": "PhoneHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhoneHub"] }
  ]
}
